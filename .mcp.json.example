{
  "mcpServers": {
    "polywatch": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp",
        "--with",
        "requests",
        "python3",
        "python_api/mcp_server.py"
      ],
      "env": {
        "WEBZ_TOKEN": "<your-webz-io-token>"
      }
    }
  }
}
